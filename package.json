{
  "name": "blast-buster-nemesis-pact",
  "version": "1.0.0",
  "private": true,
  "description": "Living Covenant: negotiate composable combat rules, mid-fight amendments, readable First Contact, preserved six-sector campaign.",
  "scripts": {
    "start": "node tools/serve.js",
    "build": "node tools/build.js",
    "test": "node --test tests/*.test.js",
    "check": "node tests/check-syntax.mjs",
    "test:browser": "python3 tests/expansion_browser_test.py",
    "test:simulation": "node tests/simulate.js",
    "test:mobile": "python3 tests/expansion_browser_test.py",
    "start:lan": "node tools/serve.js --lan",
    "test:portrait": "node tests/portrait-simulate.js",
    "test:english": "python3 tests/expansion_browser_test.py",
    "test:gpu": "python3 tests/expansion_browser_test.py",
    "test:expansion": "node --test tests/expansion.test.js tests/intelligence.test.js",
    "test:visual": "python3 tests/expansion_browser_test.py",
    "test:campaign": "node tests/expansion-simulate.js",
    "test:server": "node tests/server-smoke.mjs",
    "test:audio": "python3 tests/audio_browser_test.py",
    "test:covenant": "node --test tests/covenant*.test.js",
    "test:covenant-browser": "python3 tests/covenant_browser_test.py",
    "test:covenant-simulation": "node tests/covenant-simulate.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@vercel/functions": "3.9.7"
  }
}
