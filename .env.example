# Default: explicit local rules. No upstream API call and no key required.
AI_MODE=mock
# For an explicitly authorized private pilot, change AI_MODE to live.
# Server-side only. Never put an OpenAI API key in HTML, browser storage or Git.
OPENAI_API_KEY=
# Supply a model you can access that supports Responses + strict JSON Schema.
# GPT-Live-1 is a VOICE FRONTEND, not the text model for /v1/responses.
# Actual account model access and real inference have NOT been verified here.
OPENAI_MODEL=
ALLOWED_ORIGIN=http://127.0.0.1:8080
# Generate a random 32-byte hex pilot code. This is NOT an OpenAI API key.
PILOT_ACCESS_TOKEN=
# New covenant gateway only: per-process lifetime call cap (1..500), 8/minute.
# Restarts and additional instances reset/duplicate this cap. NOT a billing cap.
PILOT_MAX_CALLS=100
# tools/serve.js reads PORT; match ALLOWED_ORIGIN exactly.
PORT=8080
# Start with: node --env-file=.env tools/serve.js
# Before PUBLIC release: authenticated users, durable quotas, shared global cap,
# platform spend limits, a kill switch, real browser and model verification.
