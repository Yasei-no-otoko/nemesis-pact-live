# Safe defaults: offline rules, kill switch on, voice off.
AI_MODE=mock
OPENAI_KILL_SWITCH=true
GATEWAY_KILL_SWITCH=true
OPENAI_VOICE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
TEXT_PROVIDER=vercel
AI_GATEWAY_API_KEY=
OPENAI_VOICE_MODEL=gpt-live-1
ALLOWED_ORIGIN=https://example.invalid
APP_SESSION_SECRET=
APP_SESSION_TTL_SECONDS=900
PORT=8080

# Durable Redis REST (server-only; never expose these values to the browser).
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Direct OpenAI verification budget: total $10, pool allocations sum to $10.
OPENAI_BUDGET_CAP_MICRODOLLARS=10000000
OPENAI_POOL_VERIFICATION_CAP_MICRODOLLARS=3000000
OPENAI_POOL_PUBLIC_CAP_MICRODOLLARS=5000000
OPENAI_POOL_JUDGING_CAP_MICRODOLLARS=2000000
OPENAI_TEXT_BUDGET_CAP_MICRODOLLARS=0
OPENAI_VOICE_BUDGET_CAP_MICRODOLLARS=10000000
OPENAI_BUDGET_POOL=verification
OPENAI_MAX_CONCURRENT=1

# Vercel AI Gateway budget: total $20, pool allocations sum to $20.
GATEWAY_BUDGET_CAP_MICRODOLLARS=20000000
GATEWAY_POOL_VERIFICATION_CAP_MICRODOLLARS=1000000
GATEWAY_POOL_PUBLIC_CAP_MICRODOLLARS=14000000
GATEWAY_POOL_JUDGING_CAP_MICRODOLLARS=5000000
GATEWAY_TEXT_BUDGET_CAP_MICRODOLLARS=20000000
GATEWAY_VOICE_BUDGET_CAP_MICRODOLLARS=0
GATEWAY_BUDGET_POOL=verification
GATEWAY_MAX_CONCURRENT=1

# Required durable kill and admission controls. Set explicit values per deployment.
